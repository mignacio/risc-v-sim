// RISC-V RV32I Simulator — Test Suite
import "./riscv_sim.salt".{decode, dispatch, reg_get, reg_set}
import metal

// ============= Test Harness =============

tests_total mut = 0
tests_failed mut = 0

check(got int, expected int, name string) {
    outer mut tests_total
    outer mut tests_failed
    tests_total += 1
    cond got != expected {
        tests_failed += 1
        print("FAIL {name}: got {got}, expected {expected}")
    }
}

// Encode an R-type instruction word from its fields.
// R-type layout: [funct7|rs2|rs1|funct3|rd|opcode=0x33]
// funct3 selects the operation (0=ADD/SUB, 1=SLL, 2=SLT, 4=XOR, 5=SRL/SRA, 6=OR, 7=AND)
// funct7 disambiguates variants (0x00=normal, 0x20=SUB/SRA)
encode_r(funct7 int, rs2 int, rs1 int, funct3 int, rd int) int {
    return metal { (funct7 << 25) | (rs2 << 20) | (rs1 << 15) | (funct3 << 12) | (rd << 7) | 0x33 }
}

// Encode an I-type instruction word from its fields.
// I-type layout: [imm(12bit)|rs1|funct3|rd|opcode=0x13]
// funct3 selects the operation (0=ADDI, 1=SLLI, 2=SLTI, 4=XORI, 5=SRLI/SRAI, 6=ORI, 7=ANDI)
encode_i(imm int, rs1 int, funct3 int, rd int) int {
    return metal { (imm << 20) | (rs1 << 15) | (funct3 << 12) | (rd << 7) | 0x13 }
}

// Decode and execute a single instruction word.
run(coded_inst int) {
    for _ in [0] {
        inst = decode(coded_inst) else { break }
        dispatch(inst)
    }
}

// ============= Tests =============
// All tests use x1=42 and x2=10 as base operands.
// Each instruction writes its result to a different destination register (x3..x25)
// so tests don't interfere with each other.

// --- ADDI: set up base registers ---
// ADDI rd, rs1, imm: rd = rs1 + imm
run(encode_i(42, 0, 0, 1))   // x1 = x0 + 42 = 42
run(encode_i(10, 0, 0, 2))   // x2 = x0 + 10 = 10
check(reg_get(1), 42, "ADDI x1, x0, 42")
check(reg_get(2), 10, "ADDI x2, x0, 10")

// --- R-Type: register-register operations ---

// ADD: x3 = x1 + x2 = 42 + 10 = 52
run(encode_r(0x00, 2, 1, 0, 3))
check(reg_get(3), 52, "ADD 42+10")

// SUB: x4 = x1 - x2 = 42 - 10 = 32 (funct7=0x20 selects SUB over ADD)
run(encode_r(0x20, 2, 1, 0, 4))
check(reg_get(4), 32, "SUB 42-10")

// XOR: x5 = x1 ^ x2 = 0b101010 ^ 0b001010 = 0b100000 = 32
run(encode_r(0, 2, 1, 4, 5))
check(reg_get(5), 32, "XOR 42^10")

// OR: x6 = x1 | x2 = 0b101010 | 0b001010 = 0b101010 = 42
run(encode_r(0, 2, 1, 6, 6))
check(reg_get(6), 42, "OR 42|10")

// AND: x7 = x1 & x2 = 0b101010 & 0b001010 = 0b001010 = 10
run(encode_r(0, 2, 1, 7, 7))
check(reg_get(7), 10, "AND 42&10")

// SLL: x8 = x1 << (x2 & 0x1F) = 42 << 10 = 43008
run(encode_r(0, 2, 1, 1, 8))
check(reg_get(8), 43008, "SLL 42<<10")

// SRL: logical shift right. First set x9=1 as shift amount.
// x10 = x1 >> (x9 & 0x1F) = 42 >> 1 = 21
run(encode_i(1, 0, 0, 9))
run(encode_r(0, 9, 1, 5, 10))
check(reg_get(10), 21, "SRL 42>>1")

// SRA: arithmetic shift right (funct7=0x20 selects SRA over SRL)
// x11 = x1 >>> (x9 & 0x1F) = 42 >> 1 = 21 (same as SRL for positive values)
run(encode_r(0x20, 9, 1, 5, 11))
check(reg_get(11), 21, "SRA 42>>1")

// SLT: set less than. x12 = (x1 < x2) ? 1 : 0 = (42 < 10) ? 1 : 0 = 0
run(encode_r(0, 2, 1, 2, 12))
check(reg_get(12), 0, "SLT 42<10")

// SLT reversed: x13 = (x2 < x1) ? 1 : 0 = (10 < 42) ? 1 : 0 = 1
run(encode_r(0, 1, 2, 2, 13))
check(reg_get(13), 1, "SLT 10<42")

// --- I-Type: register-immediate operations ---

// XORI: x14 = x1 ^ 0xFF = 42 ^ 255 = 213
run(encode_i(0xFF, 1, 4, 14))
check(reg_get(14), metal { 42 ^ 0xFF }, "XORI 42^0xFF")

// ORI: x15 = x1 | 0x0F = 42 | 15 = 47
run(encode_i(0x0F, 1, 6, 15))
check(reg_get(15), metal { 42 | 0x0F }, "ORI 42|0x0F")

// ANDI: x16 = x1 & 0x0F = 42 & 15 = 10 (keep low nibble)
run(encode_i(0x0F, 1, 7, 16))
check(reg_get(16), metal { 42 & 0x0F }, "ANDI 42&0x0F")

// SLLI: x17 = x1 << 3 = 42 * 8 = 336
run(encode_i(3, 1, 1, 17))
check(reg_get(17), 336, "SLLI 42<<3")

// SRLI: x18 = x1 >> 1 = 42 / 2 = 21
run(encode_i(1, 1, 5, 18))
check(reg_get(18), 21, "SRLI 42>>1")

// SRAI: arithmetic right shift. imm[11:5]=0x20 selects SRAI over SRLI.
// x19 = x1 >>> 1 = 42 / 2 = 21 (same as SRLI for positive values)
run(encode_i(metal { 0x20 << 5 | 1 }, 1, 5, 19))
check(reg_get(19), 21, "SRAI 42>>1")

// SLTI: x20 = (x1 < 100) ? 1 : 0 = (42 < 100) = 1
run(encode_i(100, 1, 2, 20))
check(reg_get(20), 1, "SLTI 42<100")

// SLTI: x21 = (x1 < 10) ? 1 : 0 = (42 < 10) = 0
run(encode_i(10, 1, 2, 21))
check(reg_get(21), 0, "SLTI 42<10")

// --- x0 hardwire ---
// In RISC-V, register x0 is hardwired to zero. Writing to it must have no effect.
run(encode_i(99, 0, 0, 0))   // ADDI x0, x0, 99 — tries to set x0 = 99
check(reg_get(0), 0, "x0 stays zero")

// --- Chained computation: fibonacci-like sequence ---
// Verifies that results from one instruction can be used by the next.
run(encode_i(8, 0, 0, 22))              // x22 = 8
run(encode_i(13, 0, 0, 23))             // x23 = 13
run(encode_r(0, 23, 22, 0, 24))         // x24 = x22 + x23 = 8 + 13 = 21
check(reg_get(24), 21, "ADD 8+13")
run(encode_r(0, 24, 23, 0, 25))         // x25 = x23 + x24 = 13 + 21 = 34
check(reg_get(25), 34, "ADD 13+21")

// --- Summary ---
print("")
cond tests_failed == 0 {
    print("All {tests_total} tests passed")
}
cond tests_failed != 0 {
    print("{tests_failed}/{tests_total} tests FAILED")
}
